{
  "name": "spooner",
  "version": "0.10.0",
  "private": true,
  "description": "AI coding readiness audit + incremental transformation skill for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "test": "node --test \"skills/spooner/test/*.test.ts\"",
    "check": "npm run typecheck && npm run lint:md && npm run lint && npm run test",
    "verify": "npm run check && pre-commit run --all-files",
    "lint": "eslint . && prettier --check \"**/*.{js,ts,mjs,cjs}\"",
    "format": "prettier --write \"**/*.{js,ts,mjs,cjs}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
